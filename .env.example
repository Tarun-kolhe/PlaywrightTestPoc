# Copy to .env (git-ignored) and fill in. In Jenkins these come from Credentials.

# --- Run selection (optional here; usually set per run, case-insensitive) ---
# BRAND=DAZN_UK         # DAZN_UK | DAZN_ES | DAZN_DE
# TEST_ENV=QA           # QA | UAT | PREPROD | PROD
# DEVICE=all            # all | desktop | mobile
# RUN_ON=local          # local | lambdatest

# --- User passwords: <BRAND>_<ENV>_<ROLE>_PWD, referenced by secretKey in data/users/*.json ---
# (not needed yet: the site-health scenario doesn't log in)
DAZN_UK_QA_STANDARD_PWD=
DAZN_UK_UAT_STANDARD_PWD=
DAZN_ES_QA_STANDARD_PWD=
DAZN_ES_UAT_STANDARD_PWD=
DAZN_DE_QA_STANDARD_PWD=
DAZN_DE_UAT_STANDARD_PWD=

# --- LambdaTest ---
LT_USERNAME=
LT_ACCESS_KEY=
# LT_CONCURRENCY=2      # Playwright workers on the grid; keep <= your plan's concurrency
# LT_TUNNEL=false       # true if QA/UAT are only reachable from the office network
# LT_TUNNEL_NAME=
# LT_REAL_DEVICES=false # true = mobile projects run on real Android/iOS devices
# LT_IOS_DEVICE=iPhone 15      # real iPhone model (LambdaTest needs iOS >= 17)
# LT_IOS_VERSION=17
# LT_ANDROID_DEVICE=Galaxy S26 Ultra
# LT_ANDROID_VERSION=16
# LT_BUILD=             # override the build name (default <BRAND>-<ENV>-<BUILD_NUMBER|local>)
# LT_ORIGIN_HEADER=     # value of the x-origin-node header the DAZN firewall allowlists for LambdaTest (ask the team / see Selenium DriverFactory)
